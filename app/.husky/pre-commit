#!/bin/sh
# Git Hook cwd = working tree root (repo root), mà package.json + node_modules
# nằm trong app/ — vào đó rồi gọi THẲNG binary local; không đi qua `npx` để
# tránh đụng npm cache (máy này từng dính EPERM do cache root-owned).
cd app || exit 1

if [ -x node_modules/.bin/lint-staged ]; then
  node_modules/.bin/lint-staged
else
  echo "⚠️ node_modules/app thiếu lint-staged — chạy `npm install` trong app/ trước khi commit."
  exit 1
fi