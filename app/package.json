{
  "name": "reado",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,mjs}\" \"e2e/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,mjs}\" \"e2e/**/*.mjs\" \"scripts/**/*.mjs\"",
    "prepare": "husky && node scripts/setup-hooks.mjs",
    "preview": "vite preview",
    "cert": "node scripts/gen-cert.mjs",
    "dev:https": "READO_HTTPS=1 vite --host --port 5174 --strictPort",
    "preview:https": "READO_HTTPS=1 vite preview --host --port 4174 --strictPort",
    "e2e": "node e2e/capture-flow.mjs",
    "e2e:encode": "node e2e/capture-encode.mjs",
    "e2e:storage": "node e2e/storage-persist.mjs",
    "e2e:opfs": "node e2e/opfs-capability.mjs",
    "e2e:export": "node e2e/export-flow.mjs",
    "e2e:secure": "node e2e/secure-context.mjs",
    "e2e:library": "node e2e/library-flow.mjs",
    "e2e:home": "node e2e/home-flow.mjs",
    "e2e:swipe": "node e2e/review-swipe.mjs",
    "e2e:read": "node e2e/read-flow.mjs",
    "e2e:cram": "node e2e/cram-flow.mjs",
    "e2e:settings": "node e2e/settings-flow.mjs",
    "e2e:all": "node e2e/run-all.mjs",
    "analytics": "node scripts/analytics.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
