{
  "permissions": {
    "allow": [
      "Bash(scripts/test.sh)",
      "Bash(scripts/test.sh *)",
      "Bash(python3 scripts/repo_map.py)",
      "Bash(python3 scripts/repo_map.py *)",
      "Bash(python3 scripts/pbxproj_tool.py check)",
      "Bash(python3 scripts/pbxproj_tool.py list)",
      "Bash(node scripts/verify/check-doc-links.mjs)",
      "Bash(node scripts/verify/check-doc-links.mjs *)",
      "Bash(xcrun simctl list *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)",
      "Bash(git --no-pager *)",
      "Bash(git add *)",
      "Bash(git check-ignore *)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(sed -n *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(scripts/verify/audit.sh)",
      "Bash(python3 scripts/verify/test_guard.py)",
      "Bash(scripts/close_plan.sh *)",
      "Bash(scripts/sim_screens.sh *)",
      "Bash(python3 scripts/diag_summary.py *)",
      "Bash(scripts/pull_diagnostics.sh *)",
      "Bash(git mv *)"
    ],
    "deny": [
      "Read(./DerivedData/**)",
      "Read(./.xcode-packages/**)",
      "Read(./app/Reado.xcodeproj/project.pbxproj)",
      "Read(./.env)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py"
          }
        ]
      }
    ]
  }
}
