# Reado — mẫu biến môi trường. Copy thành `.env` rồi điền giá trị thật.
# `.env` bị gitignore; file này chỉ chứa placeholder, được track.

# --- proxy/ (FastAPI, `proxy/main.py`) ---
# Key Gemini — chỉ nằm ở proxy, không nhúng vào app.
GEMINI_API_KEY=
# Model multimodal Gemini (mặc định trong code: gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash

# --- App / test (đặt trong scheme Xcode hoặc shell, không cần file này) ---
# URL proxy khi chạy app Debug.
# READO_PROXY_BASE_URL=http://localhost:8080
# Seed agent AI-Box cho simulator (scripts/sim_aibox.sh).
# READO_DEV_AIBOX_KEY=
# Test mạng thật, opt-in (LiveAIBoxTests).
# READO_LIVE_AIBOX_KEY=
# Seed CSV demo vào simulator (đường dẫn file trên máy host).
# READO_DEV_DEMO_CSV=
